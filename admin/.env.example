# ───────────────────────────────────────────────
# SkillStreak AI — Admin Console Environment
# Copy this file to `.env.local` for local dev.
# Both values have localhost defaults, so this is only needed when deploying.
# ───────────────────────────────────────────────

# Backend API the console talks to
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Learner app, for the "open learner app" link
NEXT_PUBLIC_LEARNER_URL=http://localhost:3000
