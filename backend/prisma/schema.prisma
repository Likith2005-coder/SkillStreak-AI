// SkillStreak AI — Prisma schema
// Phase 1: User + UserProfile (auth, onboarding survey).
// Phase 2: Domain, Roadmap, Topic (with embedding), UserProgress.
// Phase 3: ChatSession + ChatMessage (streaming chatbot with intent routing).
// Phase 4: QuizAttempt (LLM-generated MCQs, score, mark complete).
// Phase 6: Streak, Badge, UserBadge, XpEvent (streaks/XP/badges/leaderboard).
// Phase 7: Resource (curated videos + docs per topic, 7-day cache).
// Phase 8: digest_enabled flag on UserProfile (notifications opt-in).
// Database: Supabase Postgres (Tokyo), via Supavisor pooler.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("user") // 'user' | 'admin'
  level        Int      @default(1)
  xp           Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile      UserProfile?
  progress     UserProgress[]
  chatSessions ChatSession[]
  quizAttempts QuizAttempt[]
  streak       Streak?
  badges       UserBadge[]
  xpEvents     XpEvent[]

  @@map("users")
}

model UserProfile {
  userId           String   @id @map("user_id")
  priorLevel       String   @map("prior_level")            // 'none' | 'some' | 'experienced'
  goal             String                                  // 'interview' | 'awareness' | 'curiosity'
  pace             String                                  // 'relaxed' | 'standard' | 'intense'
  preferredDomains String[] @default([]) @map("preferred_domains") // domain slugs; FK to domains in Phase 2
  reminderTime     String?  @map("reminder_time")          // 'HH:mm' (24h, user-local); used by Phase 8
  digestEnabled    Boolean  @default(true) @map("digest_enabled")  // weekly Sunday digest opt-in (Phase 8)
  onboardedAt      DateTime @default(now()) @map("onboarded_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Domain {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String                                  // lucide icon name, e.g. "shield-check"
  color       String                                  // tailwind hue, e.g. "indigo" | "emerald"
  difficulty  String                                  // 'beginner' | 'intermediate' | 'mixed'
  isCurated   Boolean  @default(false) @map("is_curated")
  orderIndex  Int      @map("order_index")            // gallery ordering
  createdAt   DateTime @default(now()) @map("created_at")

  roadmap     Roadmap?

  @@map("domains")
}

model Roadmap {
  id            String   @id @default(uuid())
  domainId      String   @unique @map("domain_id")
  title         String
  totalTopics   Int      @map("total_topics")
  estimatedDays Int      @map("estimated_days")
  createdAt     DateTime @default(now()) @map("created_at")

  domain        Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  topics        Topic[]

  @@map("roadmaps")
}

model Topic {
  id         String   @id @default(uuid())
  roadmapId  String   @map("roadmap_id")
  orderIndex Int      @map("order_index")
  title      String
  summary    String
  difficulty String                                  // 'easy' | 'standard' | 'hard'
  phase      String                                  // 'foundations' | 'core' | 'advanced'
  embedding  Unsupported("vector(1536)")?           // populated in Phase 7 recommender
  createdAt  DateTime @default(now()) @map("created_at")

  roadmap    Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  progress   UserProgress[]
  chatSessions ChatSession[]
  quizAttempts QuizAttempt[]
  resources  Resource[]

  @@unique([roadmapId, orderIndex])
  @@map("topics")
}

model UserProgress {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  topicId          String    @map("topic_id")
  status           String                                  // 'not_started' | 'in_progress' | 'completed'
  bestScore        Int?      @map("best_score")
  timeSpentSeconds Int       @default(0) @map("time_spent_seconds")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@map("user_progress")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  topicId   String?  @map("topic_id")               // optional pinned topic context
  title     String                                  // first user message, truncated, or "New chat"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String                                   // 'user' | 'assistant' | 'system'
  content   String   @db.Text
  intent    String?                                  // 'explain' | 'roadmap' | 'quiz' | 'recommend' | 'doubt' | 'motivational'
  tokens    Int?
  createdAt DateTime @default(now()) @map("created_at")

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model Streak {
  userId          String   @id @map("user_id")
  currentStreak   Int      @default(0) @map("current_streak")
  longestStreak   Int      @default(0) @map("longest_streak")
  lastActiveDate  DateTime? @map("last_active_date") @db.Date  // YYYY-MM-DD UTC
  freezesAvailable Int     @default(1) @map("freezes_available") // banked freezes (max 2)
  freezesUsedAt   DateTime? @map("freezes_used_at")             // last time a freeze was consumed
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model Badge {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  icon        String                                  // lucide icon name
  criteria    Json                                    // e.g. { "type": "streak_days", "value": 7 }
  orderIndex  Int      @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  awards      UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model XpEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String                                    // 'topic_complete' | 'quiz_pass' | 'quiz_perfect' | 'streak_day' | 'first_topic_of_day' | 'comeback'
  meta      Json?                                     // optional context (topicId, score, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("xp_events")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  topicId     String   @map("topic_id")
  level       String                                  // 'beginner' | 'intermediate' | 'advanced'
  questions   Json                                    // [{ question, options, correctIndex, explanation }]
  userAnswers Json     @map("user_answers")           // [number] — selected option index per question
  score       Int                                     // 0..5
  total       Int                                     // 5
  passed      Boolean                                 // score >= 3
  attemptedAt DateTime @default(now()) @map("attempted_at")

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId, attemptedAt(sort: Desc)])
  @@map("quiz_attempts")
}

model Resource {
  id              String   @id @default(uuid())
  topicId         String   @map("topic_id")
  type            String                                  // 'video' | 'doc'
  title           String
  url             String
  source          String                                  // YouTube channel, doc site name (e.g. "MDN")
  thumbnailUrl    String?  @map("thumbnail_url")
  durationSeconds Int?     @map("duration_seconds")       // videos only
  orderIndex      Int      @map("order_index")            // display order within (topicId, type)
  qualityScore    Int      @default(0) @map("quality_score") // for future ranking; admin/click signal
  createdAt       DateTime @default(now()) @map("created_at")

  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, type, orderIndex])
  @@map("resources")
}
