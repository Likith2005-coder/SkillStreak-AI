# ───────────────────────────────────────────────
# SkillStreak AI — Backend Environment
# Copy this file to `.env` and fill in real values.
# ───────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://skillstreak:skillstreak_dev@localhost:5432/skillstreak_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# LLM Provider (pick one — fill the matching key)
# Free option: get a Gemini key from https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini          # openai | anthropic | gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash   # e.g. gpt-4o-mini | claude-haiku-4-5 | gemini-2.0-flash | gemini-1.5-flash

# External APIs
YOUTUBE_API_KEY=

# Email (for Phase 8 — leave blank for now)
RESEND_API_KEY=
EMAIL_FROM=noreply@skillstreak.ai
