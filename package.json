{
  "name": "skillstreak-ai",
  "version": "0.1.0",
  "private": true,
  "description": "SkillStreak AI - AI-powered learning platform",
  "workspaces": [
    "frontend",
    "backend",
    "admin"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend,admin -c cyan,magenta,green \"npm:dev:frontend\" \"npm:dev:backend\" \"npm:dev:admin\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "dev:admin": "npm --workspace @skillstreak/admin run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm --workspace frontend run build",
    "build:backend": "npm --workspace backend run build",
    "lint": "npm --workspaces --if-present run lint",
    "test": "npm --workspaces --if-present run test",
    "type-check": "npm --workspaces --if-present run type-check",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
